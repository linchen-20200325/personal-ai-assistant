# Copy to .env (gitignored) and adjust. Load with: uv run --env-file .env ...
# Never put real credentials in this file; it is committed.

# Global kill switch for every WRITE_LOW / WRITE_HIGH action. Default: false.
ASSISTANT_WRITES_ENABLED=false

# Comma-separated WRITE_LOW tool names allowed to run without confirmation.
# Empty by default. WRITE_HIGH tools are rejected here at startup.
ASSISTANT_AUTO_WRITE_LOW=

# Seconds a pending confirmation stays approvable (1..86400). Default: 600.
ASSISTANT_CONFIRMATION_TTL_SECONDS=600

# Append-only audit log (JSON Lines). Default: var/audit.jsonl (gitignored).
ASSISTANT_AUDIT_LOG_PATH=var/audit.jsonl

# IANA time zone used to resolve "tomorrow afternoon" etc. Empty = host local zone.
ASSISTANT_TIMEZONE=

# --- LLM planner (Anthropic adapter; install extra: personal-ai-assistant[anthropic]) ---
# Secret: set in your real .env or secret manager only. Never commit a value.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-opus-5-5 / 60 / medium.
ASSISTANT_ANTHROPIC_MODEL=
ASSISTANT_ANTHROPIC_TIMEOUT_SECONDS=
ASSISTANT_ANTHROPIC_EFFORT=

# Google OAuth credentials are intentionally absent: they arrive with their
# adapters (B4) via environment / secret manager. See docs/security.md.
