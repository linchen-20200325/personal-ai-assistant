# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json
client_secret*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local runtime data (audit logs, stores)
/var/
*.jsonl

# Editors / OS
.idea/
.vscode/
.DS_Store

# OAuth client files (must live outside the repo; belt and braces)
*oauth*client*.json
client*.json
